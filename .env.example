# Obtain from https://tokenfactory.nebius.com/ ; never commit a live key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Required for stable signed plans across multiple instances/restarts.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SIGNING_KEY=

# Local, clearly labeled offline demonstration ONLY. Disable for hackathon live judging.
DEMO_MODE=false
